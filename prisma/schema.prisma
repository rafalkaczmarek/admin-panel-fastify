generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @map("user_id")
  email         String         @unique(map: "users_email_key")
  passwordHash  String         @map("password_hash")
  roles         String[]       @default([]) @map("roles")
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("refresh_token_id")
  tokenHash String   @unique(map: "refresh_tokens_token_hash_key") @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model Product {
  id              String   @id @default(uuid()) @map("product_id")
  image           String   @map("image")
  name            String   @map("name")
  category        String   @map("category")
  price           Decimal  @map("price") @db.Decimal(10, 2)
  piece           Int      @default(0) @map("piece")
  availableColors String[] @default([]) @map("available_colors")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category], map: "idx_products_category")
  @@index([name], map: "idx_products_name")
  @@map("products")
}
